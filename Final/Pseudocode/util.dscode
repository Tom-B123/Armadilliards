Util:

class Util
    private numHex
    private hexNum
    
    //Stores the conversions to and from hex
    extra = 0
    for i = 0 to 15 do
        //48-58 = 0-9 in ascii
        if i <= 9 then extra = 48
        //65-70 = A-F in ascii
        else extra = 55 endif

        char = toAscii(i+extra)
        //Stores the conversion to and from hex
        numHex[i] = char
        hexNum[char] = i
    end

    private a
    private b

    //Stores conversions from string to bool
    private toBoolDict = {
        "true"  -> true
        "false" -> false
    }

    //Splits a string into a table, by each seperator character
    public procedure split(str,sep)
        found = false 
        out   = []
        temp  = ""

        for ind = 0 to str.length do
            char = str[ind]
            if char == sep then
                found = true
                out.push(tmp)
                tmp = ""
            else
                tmp = tmp + char
            endif
        end
        if found == false then return null endif

        out.push(tmp)
        return out
    endprocedure

    //Calculates a random string of numbers for use as an ID.
    //Uses a salt to allow for multiple IDs to be created in the same ms.
    public procedure calculateID(length,salt)
        //Get the clock time in ms
        seed = Socket.gettime() * 10000
        if salt then seed = seed + salt endif

        //Get a random number to use as the ID
        seedRandom(seed)
        out = tostring(random(0,10^lenth-1))
        
        //Pad the start with 0s
        while out.length < length do
            out = "0" + out
        endwhile

        return out
    endprocedure

    //Convert an int to hexadecimal
    public procedure numToHex(num)
        if num < 0 then return -1 endif

        out = ""
        repeat
            charNum = floor(num) % 16
            char = numHex[charNum]

            out = char + out
            num = floor(num / 16)
        until num == 0
        return out
    endprocedure

    //Convert a hexidecimal number to int
    public procedure hexToNum(hex)
        sum = 0
        mult = 1
        for i = hex.length to 1 step -1 do
            char = hex[i]
            sum = sum + hexNum[char] * mult
            mult = mult * 16
        end
        return sum
    endprocedure

    //convert and x,y float coord to hex
    public procedure coordToHex(x,y)
        if x > 4096 then x = 4096 endif
        if y > 4096 then y = 4096 endif
        if x < 0 then x = 0 endif
        if y < 0 then y = 0 endif

        //Multiplied by 10 to hold 1DP of accuracy
        return numToHex(x*10),numToHex(y*10)
    endprocedure

    //convert an x,y hex coord to float
    public procedure hexToCoord(hexX,hexY)
        return hexToNum(hexX)/10, hexTONum(hexY)/10
    endprocedure

    //Returns the x,y vector of WASD inputs, as well as the two abilities
    public procedure processGameInputs()
        x = 0
        y = 0

        //a and b represent the two abilities, when they are -1,
        //the key is released and the ability is acitvated
        if a < 0 then a = 0 endif
        if b < 0 then b = 0 endif

        if keyDown("w") then y = y - 1 endif
        if keyDown("a") then x = x - 1 endif
        if keyDown("s") then y = y + 1 endif
        if keyDown("d") then x = x + 1 endif

        if leftMouseDown() then a = a + 1
        elseif a > 0 then a = -1 endif

        if rightMouseDown() then b = b + 1
        elseif b > 0 then b = -1 endif

        return x,y,a,b
    endprocedure

    //Returns pythagorus distance
    public procedure findDistance(x,y)
        return sqrt((x*x)+(y*y))
    endprocedure

    //Returns the manhattan distance
    public procedure manhattanDistance(x,y)
        return abs(x) + abs(y)
    endprocedure

    //Returns the angle a circle rolls, given the arc length and radius
    public procedure pitchAngle(distance,radius)
        return distance / radius
    endprocedure

    //Returns the 'central' angle in a triangle of length x by y
    public procedure yawAngle(x,y)
        ax,ay = abs(x),abs(y)
        if x > 0 and y >= 0 then
            return atan(ay/ax)
        elseif x <= 0 and y > 0 then
            return atan(ax/ay) + pi / 2
        elseif x < 0 and y <= 0 then
            return atan(ay/ax) + pi
        elseif x >= 0 and y < 0 then
            return atan(ax/ay) + pi * 3 / 2
        endif
    endprocedure

    //Converts a string to a bool, not native to lua
    public procedure toBool(string)
        if string.type == "boolean" then return string endif
        if string.type == "string"  then return toBoolDict[string] endif
        return null
    endprocedure

    //Hashes two or more IDs to give a semi-unique identifier for that combination of IDs.
    //Checking if the hash is within a set is faster than iterating through every ID
    //to see if that combination has occured before
    public procedure hashIDs(IDs)
        local sum = 0
        for ind = 0 to IDs.length do
            numID = toint(IDs[ind])
            //IDs are squared then summed together, giving a sum that is unlikely to appear
            //from a different set if IDs.
            sum = sum + (numID * numID)
        end
        return sum
    endprocedure

    //Uses newton-raphson approximation to calculate the sqaure root. Runs slower than the native
    //sqrt operator so isn't used.
    public procedure fastSqrt(num,steps)
    tmp = num/2
    for i = 1 to steps do
        tmp = tmp - (((tmp*tmp)-num) / (2*tmp))
    end
endclass

util = new Util()

return util